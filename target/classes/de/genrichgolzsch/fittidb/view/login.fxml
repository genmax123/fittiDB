<?xml version="1.0" encoding="UTF-8"?> <!-- XML Header -->

<?import javafx.geometry.Insets?>      <!-- Padding -->
<?import javafx.scene.control.*?>      <!-- Controls -->
<?import javafx.scene.layout.*?>       <!-- Layouts -->


<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.genrichgolzsch.fittidb.controller.LoginController"
      spacing="12">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding> <!-- Root Container -->

    <Label text="FittiDB Login" style="-fx-font-size: 18px; -fx-font-weight: bold;"/> <!-- Titel -->

    <TextField fx:id="tfUsername" promptText="Username"/> <!-- Username -->

    <PasswordField fx:id="pfPassword" promptText="Password"/> <!-- Passwort -->

    <Button text="Login" onAction="#onLogin"/> <!-- Button -->

    <Label fx:id="lblStatus" text="" wrapText="true"/> <!-- Status / Fehler -->

</VBox>
