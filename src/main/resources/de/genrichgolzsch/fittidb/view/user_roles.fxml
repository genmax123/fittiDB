<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.genrichgolzsch.fittidb.controller.UserRoleController"
      style="-fx-padding: 12;">

    <Label text="User- &amp; Rollenübersicht"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TableView fx:id="table">
        <columns>
            <TableColumn text="User-ID" fx:id="colUserId" prefWidth="80"/>
            <TableColumn text="Username" fx:id="colUsername" prefWidth="150"/>
            <TableColumn text="Rolle" fx:id="colRole" prefWidth="150"/>
            <TableColumn text="Beschreibung" fx:id="colDescription" prefWidth="300"/>
            <TableColumn text="Aktiv" fx:id="colActive" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Aktualisieren" onAction="#onRefresh"/>
    </HBox>
</VBox>
