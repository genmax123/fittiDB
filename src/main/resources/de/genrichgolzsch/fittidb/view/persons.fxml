<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.genrichgolzsch.fittidb.controller.PersonsController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Button text="← Zurück" onAction="#onBack"/>
            <Label text="Persons" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#onRefresh"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <TableView fx:id="tvPersons" prefHeight="520">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colFirstName" text="Vorname" prefWidth="140"/>
                    <TableColumn fx:id="colLastName" text="Nachname" prefWidth="160"/>
                    <TableColumn fx:id="colEmail" text="E-Mail" prefWidth="220"/>
                    <TableColumn fx:id="colCity" text="Stadt" prefWidth="160"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button text="Profil-PDF (Auswahl)" onAction="#onExportProfilePdf"/>
                <Button text="Mitgliederliste-PDF" onAction="#onExportPersonsPdf"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" text="" wrapText="true"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
